# Copia este archivo como .env (no se sube al repositorio) y completa los valores.

# Desarrollo local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Firebase (proyecto "gestuvoz")
FIREBASE_PROJECT_ID=gestuvoz
# Ruta al JSON de la cuenta de servicio, FUERA del repositorio:
FIREBASE_CREDENTIALS_FILE=C:\Users\Angelo\Documents\Firestore-secrets\gestuvoz-firebase.json
# En Render, en lugar de la ruta, pega el contenido del JSON en esta variable:
# FIREBASE_CREDENTIALS_JSON=
# Bucket de Cloud Storage para las imagenes de los pictogramas personalizados:
FIREBASE_STORAGE_BUCKET=gestuvoz.firebasestorage.app
